NODE_ENV=development
PORT=8000

# MongoDB ulanish (MongoDB Atlas yoki lokal: mongodb://127.0.0.1:27017/ustachi)
MONGODB_URI=mongodb://127.0.0.1:27017/ustachi

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d

CORS_ALLOWED_ORIGINS=*
# Yoki vergul bilan: http://localhost:3000,https://example.com
# Productionda majburiy (CORS_ALLOWED_ORIGINS='*' bo'lishi mumkin emas)

# Cookie parametrlari
# Frontend boshqa domen bo'lsa (masalan API subdomen): ustachi.uz
# Bo'sh qoldirilsa — host-only cookie ishlatiladi
COOKIE_DOMAIN=

# Rate limiting (15 daqiqalik oyna)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Media fayllar
MEDIA_DIR=uploads
PUBLIC_MEDIA_URL=/uploads

# Admin bootstrap (birinchi ishga tushishda admin yaratish)
ADMIN_USERNAME=admin
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=AdminPass123!
ADMIN_EMAIL=admin@example.com

# Telegram bot (ixtiyoriy — o'rnatilsa xavfsizlik uchun tekshiriladi)
BOT_TOKEN=

# Google Gemini AI (ixtiyoriy — o'rnatilmasa AI xulosa/klassifikatsiya o'chadi, tizim ishlayveradi)
# Kalit https://aistudio.google.com/app/apikey dan olinadi
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
